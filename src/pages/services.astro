---
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: "Services - cultural-arts.com",
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- Core Services -->
  <Features2
    title="Services"
    subtitle="Current tools available in the cultural-arts.com ecosystem."
    columns={2}
    items={[
      {
        title: 'Contributor App',
        description:
          'Version 1.0.1 (2026-05-31). The main app for cultural-arts.com contributors, designed for capturing and uploading large volumes of photos.',
        icon: 'tabler:camera',
        callToAction: {
          target: '_blank',
          text: 'Open',
          href: '/contributor',
        }
      },
      {
        title: 'AI Companion (GenAI Model)',
        description:
          'Version 1.0.0 (2026-11-12). Our GenAI model customized for cultural-arts.com.',
        icon: 'tabler:cpu',
        callToAction: {
          target: '_blank',
          text: 'Open',
          href: '/ai-companion',
        }
      },
    ]}
  />

</Layout>