---
import Layout from '~/layouts/PageLayout.astro';

import FAQs from '~/components/widgets/FAQs.astro';
import Hero2 from '~/components/widgets/Hero2.astro';

const metadata = {
  title: 'Cultural-arts - grow you culture by sharing arts',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    tagline="Web App"
    image={{
      src: '~/assets/images/4BnEmv.svg',
      alt: '',
    }}
  >
    <Fragment slot="title">
      [BETA] AI cultural companion <span
        class="hidden xl:inline">for visual discovery</span
      >
    </Fragment>

    <Fragment slot="subtitle">
        Take a picture of any cultural heritage artifact by using your mobile phone camera and get instant insights.
    </Fragment>

  </Hero2>

  <!-- FAQs Widget ******************* -->

  <FAQs
  title="Frequently Asked Questions"
  subtitle="Learn more about Cultural-Arts, our mission, programs, creative initiatives, and how we support computer science research and cultural heritage development."
  tagline="FAQs"
  classes={{ container: 'max-w-6xl' }}
  items={[
    {
      title: 'What is Cultural-Arts?',
      description:
        'Cultural-Arts is a global digital platform dedicated to promoting art, culture, and education in human cultural heritage. We aim to support research and development in digital cultural heritage through collaborations, digital services, and educational initiatives.',
    },
    {
      title: 'Is Cultural-Arts an open project?',
      description:
        'Yes. Cultural-Arts is developed for research and educational purposes, encouraging experimentation, collaboration, and the exploration of innovative approaches in arts, culture, and digital experiences.',
    },
    {
      title: 'How can organizations collaborate with Cultural-Arts?',
      description:
        'Collectives, universities, schools, museums, nonprofits, and cultural institutions can collaborate with us through partnerships, sponsored initiatives, or creative projects. We actively seek collaborations that strengthen cultural exchange and community impact.',
    },
    {
      title: 'Do you support educational and youth initiatives?',
      description:
        'Yes. Education and youth engagement are central to our mission. We develop programs that encourage creativity, cultural awareness, and inclusive participation for students through workshops, mentorships, and educational experiences.',
    },
    {
      title: 'How can I stay updated on upcoming events and opportunities?',
      description:
        'You can stay informed by following our news page and regularly visiting this website.',
    },
  ]}
/>

</Layout>
