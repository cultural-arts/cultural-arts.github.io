---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

const metadata = {
  title: 'Cultural-arts - grow you culture by sharing arts',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AstroWind Hero Image' }}
  >
    <Fragment slot="title">
      Free template for <span class="hidden xl:inline">creating websites with</span>
      <span class="text-accent dark:text-white"> Astro 5.0</span> + Tailwind CSS
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">AstroWind</span> is a free, customizable and production-ready template for Astro 5.0
        + Tailwind CSS.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">AstroWind: Production-ready.</span>
      Suitable for Startups, Small Business, SaaS websites, Professional Portfolios, Marketing websites, Landing Pages &
      Blogs.
    </Fragment>
  </Hero>

  <!-- FAQs Widget ******************* -->

  <FAQs
  title="Frequently Asked Questions"
  subtitle="Learn more about Cultural-Arts, our mission, programs, creative initiatives, and how we support artists, communities, and cultural development."
  tagline="FAQs"
  classes={{ container: 'max-w-6xl' }}
  items={[
    {
      title: 'What is Cultural-Arts?',
      description:
        'Cultural-Arts is a global digital platform dedicated to promoting arts, culture and education by using Artificial Intelligence. We support artistic expression through collaborations, digital services and educational initiatives.',
    },
    {
      title: 'Is Cultural-Arts an open project?',
      description:
        'Yes. Cultural-Arts is developed for research and educational purposes, encouraging experimentation, collaboration, and the exploration of innovative approaches in arts, culture, and digital experiences.',
    },
    {
      title: 'How can organizations collaborate with Cultural-Arts?',
      description:
        'Collectives, universities, schools, museums, nonprofits, and cultural institutions can collaborate with us through partnerships, sponsored initiatives, or creative projects. We actively seek collaborations that strengthen cultural exchange and community impact.',
    },
    {
      title: 'Do you support educational and youth initiatives?',
      description:
        'Yes. Education and youth engagement are central to our mission. We develop programs that encourage creativity, cultural awareness, artistic skills, and inclusive participation for students and young creatives through workshops, mentorships, and educational experiences.',
    },
    {
      title: 'How can I stay updated on upcoming events and opportunities?',
      description:
        'You can stay informed by following our latest announcements and regularly visiting this website.',
    },
  ]}
/>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Images', amount: '10K+' },
      { title: 'Arts', amount: '90K+' },
      { title: 'Continents', amount: '4' },
    ]}
  />

  <!-- CallToAction Widget ***********

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Astro&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Tailwind CSS</span>
    </Fragment>

    <Fragment slot="subtitle">
      Be very surprised by these huge fake numbers you are seeing on this page. <br class="hidden md:inline" />Don't
      waste more time! :P
    </Fragment>
  </CallToAction>
 -->

</Layout>
